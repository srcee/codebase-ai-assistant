{
  "name": "codebase-ai-assistant",
  "version": "0.0.0",
  "license": "UNLICENSED",
  "scripts": {
    "prepare": "husky",
    "start:api": "nx serve api",
    "start:web": "nx serve web",
    "lint": "nx run-many -t lint",
    "test": "nx run-many -t test",
    "build": "nx run-many -t build",
    "check": "nx run-many -t lint test build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "secrets": "secretlint \"**/*\"",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose stop postgres",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:reset": "docker compose down -v && npm run db:up && npm run db:migrate",
    "db:test:up": "docker compose --profile test up -d --wait postgres-test",
    "db:test:down": "docker compose --profile test rm -sfv postgres-test"
  },
  "lint-staged": {
    "*": [
      "secretlint",
      "prettier --write --ignore-unknown"
    ]
  },
  "private": true,
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@nx/eslint": "^23.3.0",
    "@nx/eslint-plugin": "23.3.0",
    "@nx/jest": "^23.3.0",
    "@nx/js": "23.3.0",
    "@nx/nest": "^23.3.0",
    "@nx/node": "23.3.0",
    "@nx/react": "^23.3.0",
    "@nx/vite": "^23.3.0",
    "@nx/vitest": "23.3.0",
    "@nx/web": "23.3.0",
    "@nx/webpack": "23.3.0",
    "@nx/workspace": "23.3.0",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.7",
    "@swc/cli": "~0.8.1",
    "@swc/core": "~1.15.5",
    "@swc/helpers": "~0.5.18",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.3.0",
    "@types/jest": "~30.0.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/coverage-v8": "~5.0.1",
    "@vitest/ui": "~5.0.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsx-a11y": "6.10.1",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "husky": "^9.1.7",
    "jest": "~30.3.0",
    "jest-environment-node": "~30.3.0",
    "jest-util": "~30.3.0",
    "jiti": "2.4.2",
    "jsdom": "^27.1.0",
    "lint-staged": "^16.4.0",
    "nx": "23.3.0",
    "prettier": "~3.6.2",
    "secretlint": "^13.0.7",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.7",
    "ts-node": "10.9.1",
    "tslib": "^2.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.0",
    "vitest": "~5.0.1",
    "webpack": "~5.110.0",
    "webpack-cli": "^7.0.0",
    "webpack-dev-server": "^5.2.1"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "zod": "^4.6.7"
  }
}
