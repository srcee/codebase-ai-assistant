# Copy to .env and adjust. Never commit .env.

# API binding. Must be loopback unless API_ALLOW_NON_LOOPBACK=true.
API_HOST=127.0.0.1
API_PORT=3000
API_ALLOW_NON_LOOPBACK=false

# Local PostgreSQL + pgvector (docker-compose.yml reads these). Choose your own password.
POSTGRES_USER=codebase_ai
POSTGRES_PASSWORD=change-me
POSTGRES_DB=codebase_ai
POSTGRES_PORT=5432
DATABASE_URL=postgres://codebase_ai:change-me@127.0.0.1:5432/codebase_ai

# Throwaway test database (`npm run db:test:up`). The database name must end in _test.
POSTGRES_TEST_DB=codebase_ai_test
POSTGRES_TEST_PORT=5433
TEST_DATABASE_URL=postgres://codebase_ai:change-me@127.0.0.1:5433/codebase_ai_test

# Directories repositories may be registered from, separated by ';' on Windows or ':' elsewhere. Empty means none allowed.
ALLOWED_REPO_ROOTS=
# Require a .git directory in registered repositories.
REPO_REQUIRE_GIT_DIR=true

# Local inference runtime (Ollama). Only loopback hosts (localhost, 127.0.0.1, ::1) are accepted; anything else stops the API at startup.
INFERENCE_PROVIDER=local
# Runtime adapter that answers on INFERENCE_BASE_URL. Only ollama exists.
INFERENCE_RUNTIME=ollama
INFERENCE_BASE_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=nomic-embed-text
CHAT_MODEL=qwen2.5-coder:7b
# Must match the vector column size (768 for nomic-embed-text); changing it needs a new migration and re-index.
EMBEDDING_DIMENSIONS=768
# INFERENCE_TIMEOUT_MS=30000
# Retries apply to embeddings only (network errors, timeouts, 5xx).
# INFERENCE_MAX_RETRIES=2
# EMBEDDING_BATCH_SIZE=32

# File discovery and chunking (Stage 4). Sizes are bytes or characters; lists are comma-separated.
# INGEST_MAX_FILE_BYTES=524288
# INGEST_MAX_TOTAL_BYTES=104857600
# Languages to index, by id; unset means all of them. Ids are listed in apps/api/src/app/modules/ingestion/constants/languages.ts; an unknown id stops the API at startup.
# INGEST_LANGUAGES=typescript,javascript,json,markdown,python
# Extra exclusions in .gitignore syntax, added to the built-in list. They cannot re-include built-in or secret exclusions.
# INGEST_EXCLUDE_PATTERNS=docs/generated/,*.snap
# CHUNK_MAX_CHARS=2000
# CHUNK_OVERLAP_CHARS=200
