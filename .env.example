# Copy to .env and adjust. Never commit .env.

# API binding. Must be loopback unless API_ALLOW_NON_LOOPBACK=true.
API_HOST=127.0.0.1
API_PORT=3000
API_ALLOW_NON_LOOPBACK=false

# Used from Stage 2 onward.
# DATABASE_URL=

# Directories repositories may be registered from, separated by ';' on Windows or ':' elsewhere. Empty means none allowed.
ALLOWED_REPO_ROOTS=

# Local inference runtime (Stage 5). Remote endpoints will be rejected.
INFERENCE_BASE_URL=http://127.0.0.1:11434
# EMBEDDING_MODEL=
# CHAT_MODEL=
# EMBEDDING_DIMENSIONS=
