# Copy to .env and replace every change-me. Never commit .env.
# Empty values fall back to the defaults shown here.

# --- Postgres (docker compose) ---
POSTGRES_USER=change-me
POSTGRES_PASSWORD=change-me
POSTGRES_DB=codebase_ai
POSTGRES_PORT=5432
POSTGRES_TEST_DB=codebase_ai_test
POSTGRES_TEST_PORT=5433
DATABASE_URL=postgres://change-me:change-me@127.0.0.1:5432/codebase_ai
# Integration tests only.
TEST_DATABASE_URL=postgres://change-me:change-me@127.0.0.1:5433/codebase_ai_test
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=10000
DATABASE_STATEMENT_TIMEOUT_MS=30000

# --- API ---
# Must be a loopback address.
API_HOST=127.0.0.1
API_PORT=3000
API_TOKEN_FILE=.local/api-token.secret
# error | warn | log | debug | verbose
LOG_LEVEL=log
# text | json
LOG_FORMAT=text

# --- Repositories ---
# Separated by the platform delimiter: ';' on Windows, ':' elsewhere.
ALLOWED_REPO_ROOTS=change-me
REPO_REQUIRE_GIT_DIR=true

# --- Local inference ---
INFERENCE_BASE_URL=http://127.0.0.1:11434
INFERENCE_PROVIDER=local
INFERENCE_RUNTIME=ollama
EMBEDDING_MODEL=nomic-embed-text
CHAT_MODEL=qwen2.5-coder:7b
EMBEDDING_DIMENSIONS=768
INFERENCE_TIMEOUT_MS=30000
INFERENCE_MAX_RETRIES=2
EMBEDDING_BATCH_SIZE=32
# nomic-embed-text prefixes; quote them to keep the trailing space.
EMBEDDING_QUERY_PREFIX="search_query: "
EMBEDDING_DOCUMENT_PREFIX="search_document: "

# --- Ingestion and indexing ---
INGEST_MAX_FILE_BYTES=524288
INGEST_MAX_TOTAL_BYTES=104857600
# Comma-separated language ids; unset indexes every known language.
INGEST_LANGUAGES=
# Comma-separated gitignore-style patterns.
INGEST_EXCLUDE_PATTERNS=
CHUNK_MAX_CHARS=2000
CHUNK_OVERLAP_CHARS=200
INDEXING_EMBED_CONCURRENCY=2

# --- Retrieval ---
RETRIEVAL_CANDIDATE_LIMIT=40
RETRIEVAL_MAX_CHUNKS=8
RETRIEVAL_MAX_CONTEXT_CHARS=12000
RETRIEVAL_RRF_K=60
RETRIEVAL_HNSW_EF_SEARCH=100
RETRIEVAL_DEBUG_ENDPOINT=false

# --- Chat ---
CHAT_MAX_QUESTION_CHARS=4000
CHAT_HISTORY_TURNS=4
CHAT_HISTORY_MAX_CHARS=4000
CHAT_MAX_CONCURRENT=1
CHAT_GENERATION_TIMEOUT_MS=120000
CHAT_MIN_VECTOR_SIMILARITY=0.5
CHAT_MIN_TERM_COVERAGE=0.5
# Context window for prompt and answer; CHAT_MAX_ANSWER_TOKENS must be at most half of it.
CHAT_CONTEXT_TOKENS=8192
CHAT_MAX_ANSWER_TOKENS=1024
CHAT_TEMPERATURE=0.1
CHAT_REWRITE_FOLLOW_UPS=true
# Unset keeps conversations until deleted.
CHAT_RETENTION_DAYS=

# --- Opt-in test runs (need local models and TEST_DATABASE_URL) ---
# RUN_INFERENCE_SMOKE=true
# RUN_RETRIEVAL_EVAL=true
# RUN_CHAT_EVAL=true
# RUN_HNSW_BENCHMARK=true
# EVAL_LABEL=baseline

ALLOWED_DOCUMENT_ROOTS=change-me
DOCUMENT_MAX_BYTES=52428800
PARSE_WORKERS=
PARSE_INLINE_MAX_BYTES=1048576
PARSE_TIMEOUT_MS=60000
PARSE_WORKER_MAX_MEMORY_MB=512