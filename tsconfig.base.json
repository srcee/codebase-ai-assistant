{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": true,
    "types": ["node"],
    "paths": {
      "@codebase-ai/contracts": ["./libs/shared/contracts/src/index.ts"],
      "@codebase-ai/server-config": ["./libs/server/config/src/index.ts"],
      "@codebase-ai/server-database": ["./libs/server/database/src/index.ts"],
      "@codebase-ai/server-database/testing": [
        "./libs/server/database/src/testing/index.ts"
      ],
      "@codebase-ai/server-testing": ["./libs/server/testing/src/index.ts"],
      "@codebase-ai/shared-testing": ["./libs/shared/testing/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
