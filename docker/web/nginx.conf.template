worker_processes auto;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;

events {
  worker_connections 1024;
}

http {
  include /etc/nginx/mime.types;
  default_type application/octet-stream;
  # Request paths can carry identifiers only, but nothing here needs them.
  access_log off;
  server_tokens off;
  sendfile on;

  client_body_temp_path /tmp/client_temp;
  proxy_temp_path /tmp/proxy_temp;
  fastcgi_temp_path /tmp/fastcgi_temp;
  uwsgi_temp_path /tmp/uwsgi_temp;
  scgi_temp_path /tmp/scgi_temp;

  server {
    listen 8080;
    root /usr/share/nginx/html;

    location = /healthz {
      default_type text/plain;
      return 200 "ok\n";
    }

    location /api/ {
      proxy_pass http://127.0.0.1:3000/;
      proxy_http_version 1.1;
      # Host and Origin pass through unchanged so the API's DNS-rebinding guard still applies.
      proxy_set_header Host $http_host;
      proxy_set_header Connection "";
      proxy_set_header Authorization "Bearer __API_TOKEN__";
      proxy_buffering off;
      proxy_request_buffering off;
      proxy_cache off;
      proxy_read_timeout 1h;
      proxy_send_timeout 1h;
      # Upload limits are enforced by the API while it streams the body.
      client_max_body_size 0;
    }

    location / {
      try_files $uri $uri/ /index.html;
    }
  }
}
