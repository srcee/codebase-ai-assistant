meta {
  name: Search
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/search
  body: json
  auth: inherit
}

body:json {
  {
    "query": "How does repository registration prevent unsafe paths or traversal outside allowed roots?",
    "sourceIds": ["{{codebaseId}}"]
  }
}

vars:pre-request {
  codebaseId: 524732ac-8a03-4576-85cf-7dcdc402fece
}

assert {
  res.status: eq 200
}
