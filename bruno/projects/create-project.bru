meta {
  name: Create project
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/projects
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Codebase assistant",
    "description": "Code and documentation of the assistant"
  }
}

vars:post-response {
  projectId: res.body.id
}

assert {
  res.status: eq 201
}
